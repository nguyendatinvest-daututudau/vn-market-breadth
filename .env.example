# SSI FastConnect v3 (OAuth2) — thay the SSI_CONSUMER_ID / SSI_CONSUMER_SECRET
SSI_CLIENT_ID=your_client_id_here
SSI_API_KEY=your_api_key_here
SSI_API_SECRET=your_api_secret_here
# Chi can neu account yeu cau (trading); Market Data khong can.
# SSI_PRIVATE_KEY=
# Token base64 (tu `python scripts/ssi_auth_bootstrap.py`) — dung cho CI khong can OTP.
# SSI_TOKEN_CACHE=

# Volume breakout threshold (ratio vs 20-day avg volume)
VOLUME_BREAKOUT_CLOSE=1.3
